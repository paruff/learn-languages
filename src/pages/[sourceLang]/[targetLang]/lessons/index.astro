---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../../../lib/urls';
import { getAvailablePairs } from '../../../../lib/pairLoader';

export async function getStaticPaths() {
  const pairs = await getAvailablePairs();
  return pairs.map(({ sourceLang, targetLang }) => ({ params: { sourceLang, targetLang } }));
}

const { sourceLang, targetLang } = Astro.params;

const [nodes, realisations] = await Promise.all([
  getCollection('cefr-nodes'),
  getCollection('realisations'),
]);

const lessons = nodes
  .filter((node) =>
    realisations.some((r) => r.data.nodeId === node.data.nodeId && r.data.lang === sourceLang)
  )
  .filter((node) =>
    realisations.some((r) => r.data.nodeId === node.data.nodeId && r.data.lang === targetLang)
  )
  .map((node) => node.data);
---

<BaseLayout
  title={`Lessons — ${sourceLang} → ${targetLang}`}
  sourceLang={sourceLang}
  targetLang={targetLang}
>
  <h1>Lessons</h1>
  <ul class="lesson-index">
    {
      lessons.map((node) => (
        <li>
          <a
            class="card lesson-index__item"
            href={withBase(`/${sourceLang}/${targetLang}/lessons/${node.nodeId}/`)}
          >
            <span class={`badge badge--${node.cefrLevel.toLowerCase()}`}>{node.cefrLevel}</span>
            <span class="lesson-index__can-do">{node.canDo}</span>
          </a>
        </li>
      ))
    }
  </ul>
  <p>
    <a href={withBase(`/${sourceLang}/${targetLang}/review/`)}>Go straight to review →</a>
  </p>
</BaseLayout>

<style>
  .lesson-index {
    display: grid;
    gap: var(--spacing-unit);
    list-style: none;
    padding: 0;
    margin: calc(var(--spacing-unit) * 3) 0;
  }
  .lesson-index__item {
    display: flex;
    align-items: center;
    gap: calc(var(--spacing-unit) * 2);
    text-decoration: none;
    color: var(--color-text);
    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-fast);
  }
  .lesson-index__item:hover {
    transform: translateX(4px);
    box-shadow: var(--shadow-md);
  }
  .lesson-index__can-do {
    font-weight: 500;
  }
</style>
