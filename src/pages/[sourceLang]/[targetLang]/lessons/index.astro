---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../../../lib/urls';
import { getAvailablePairs, loadPair } from '../../../../lib/pairLoader';
import { languageName } from '../../../../lib/languageNames';
import { getSkillIcon } from '../../../../lib/skillIcon';
import { getString, type StringKey } from '../../../../lib/strings';

const SKILL_KEYS: Record<string, StringKey> = {
  listening: 'skillListening',
  reading: 'skillReading',
  spoken_interaction: 'skillSpokenInteraction',
  spoken_production: 'skillSpokenProduction',
  writing: 'skillWriting',
};

export async function getStaticPaths() {
  const pairs = await getAvailablePairs();
  return pairs.map(({ sourceLang, targetLang }) => ({ params: { sourceLang, targetLang } }));
}

const { sourceLang, targetLang } = Astro.params;

const [nodes, realisations, pairedItems] = await Promise.all([
  getCollection('cefr-nodes'),
  getCollection('realisations'),
  loadPair(sourceLang, targetLang),
]);

// Per-lesson item ids (issue #37) — grouped client-side against localStorage
// via computeNodeProgress, the same mastery threshold progress.astro uses.
const nodeItemIds: Record<string, string[]> = {};
for (const item of pairedItems) {
  (nodeItemIds[item.nodeId] ??= []).push(item.target.id);
}

const lessons = nodes
  .filter((node) =>
    realisations.some((r) => r.data.nodeId === node.data.nodeId && r.data.lang === sourceLang)
  )
  .filter((node) =>
    realisations.some((r) => r.data.nodeId === node.data.nodeId && r.data.lang === targetLang)
  )
  .map((node) => node.data)
  .sort((a, b) => a.nodeId.localeCompare(b.nodeId));

// Grouped by CEFR level (audit #1) — a flat 100+ item list gave a first-time
// visitor no entry point and no sense of level progression.
const LEVEL_ORDER = ['A1', 'A2', 'B1', 'B2', 'C1', 'C2'];
const levels = LEVEL_ORDER.map((level) => ({
  level,
  lessons: lessons.filter((node) => node.cefrLevel === level),
})).filter((group) => group.lessons.length > 0);

const firstLesson = levels[0]?.lessons[0];
const targetName = languageName(targetLang);
---

<BaseLayout
  title={`${targetName} Lessons — Acquira`}
  description={`Every ${targetName} lesson available, grouped by CEFR level from A1 to C1.`}
  sourceLang={sourceLang}
  targetLang={targetLang}
>
  <h1>{getString(sourceLang, 'lessonsTitle')}</h1>

  {
    firstLesson && (
      <a
        class="card lesson-index__start"
        href={withBase(`/${sourceLang}/${targetLang}/lessons/${firstLesson.nodeId}/`)}
      >
        <p class="lesson-index__start-label">{getString(sourceLang, 'lessonsStartHere')}</p>
        <p class="lesson-index__start-title">{firstLesson.canDo}</p>
      </a>
    )
  }

  {
    levels.map(({ level, lessons: levelLessons }) => (
      <section class="lesson-index__level">
        <h2>
          <span class={`badge badge--${level.toLowerCase()}`}>{level}</span>
          {levelLessons.length}{' '}
          {getString(
            sourceLang,
            levelLessons.length === 1 ? 'lessonCountSingular' : 'lessonCountPlural'
          )}
        </h2>
        <ul class="lesson-index">
          {levelLessons.map((node) => (
            <li>
              <a
                class="card lesson-index__item"
                href={withBase(`/${sourceLang}/${targetLang}/lessons/${node.nodeId}/`)}
              >
                <svg
                  class="lesson-index__skill-icon"
                  viewBox={getSkillIcon(node.skill).viewBox}
                  width="20"
                  height="20"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d={getSkillIcon(node.skill).path} />
                </svg>
                <span class="lesson-index__can-do">{node.canDo}</span>
                <span class="lesson-index__skill-label">
                  {getString(sourceLang, SKILL_KEYS[node.skill])}
                </span>
                <span class="lesson-index__progress" data-node-id={node.nodeId} hidden />
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  <p>
    <a href={withBase(`/${sourceLang}/${targetLang}/review/`)}>
      {getString(sourceLang, 'lessonsGoToReview')}
    </a>
  </p>

  <script
    type="application/json"
    id="lesson-progress-data"
    set:html={JSON.stringify({ sourceLang, targetLang, nodeItemIds })}
  />
</BaseLayout>

<style>
  .lesson-index__start {
    display: block;
    margin: calc(var(--spacing-unit) * 2) 0 calc(var(--spacing-unit) * 3);
    padding: calc(var(--spacing-unit) * 2);
    text-decoration: none;
    color: var(--color-text);
    border-left: 3px solid var(--color-primary);
  }
  .lesson-index__start-label {
    margin: 0 0 calc(var(--spacing-unit) * 0.5);
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }
  .lesson-index__start-title {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 700;
  }
  .lesson-index__level {
    margin-bottom: calc(var(--spacing-unit) * 3);
  }
  .lesson-index__level h2 {
    display: flex;
    align-items: center;
    gap: var(--spacing-unit);
    font-size: 1.125rem;
  }
  .lesson-index {
    display: grid;
    gap: var(--spacing-unit);
    list-style: none;
    padding: 0;
    margin: calc(var(--spacing-unit) * 1.5) 0 0;
  }
  .lesson-index__item {
    display: flex;
    align-items: center;
    gap: calc(var(--spacing-unit) * 2);
    text-decoration: none;
    color: var(--color-text);
    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-fast);
  }
  .lesson-index__item:hover {
    transform: translateX(4px);
    box-shadow: var(--shadow-md);
  }
  .lesson-index__can-do {
    font-weight: 500;
    flex: 1;
  }
  .lesson-index__skill-icon {
    flex-shrink: 0;
    color: var(--color-text-muted);
  }
  .lesson-index__skill-label {
    flex-shrink: 0;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    text-transform: capitalize;
  }
  .lesson-index__progress {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: calc(var(--spacing-unit) * 0.75);
  }
  .lesson-index__progress-bar {
    width: 48px;
  }
  .lesson-index__progress-label {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    white-space: nowrap;
  }
</style>

<script>
  import { loadState } from '../../../../lib/storage';
  import { computeNodeProgress, type TrackedItem } from '../../../../lib/progress';

  const dataEl = document.getElementById('lesson-progress-data');
  const { sourceLang, targetLang, nodeItemIds } = JSON.parse(dataEl?.textContent ?? '{}') as {
    sourceLang: string;
    targetLang: string;
    nodeItemIds: Record<string, string[]>;
  };

  const items: TrackedItem[] = Object.entries(nodeItemIds).flatMap(([nodeId, itemIds]) =>
    itemIds.map((itemId) => ({
      itemId,
      nodeId,
      cefrLevel: '',
      canDo: '',
      repetitions: loadState(sourceLang, targetLang, 'forward', itemId).repetitions,
    }))
  );

  const progress = computeNodeProgress(items);

  for (const el of document.querySelectorAll<HTMLElement>('.lesson-index__progress')) {
    const nodeId = el.dataset.nodeId;
    const p = nodeId ? progress.get(nodeId) : undefined;
    if (!p) continue;

    el.hidden = false;
    el.innerHTML = `
      <span class="progress-bar lesson-index__progress-bar"><span class="progress-bar__fill" style="width: ${p.percent}%"></span></span>
      <span class="lesson-index__progress-label">${p.masteredItems}/${p.totalItems}</span>
    `;
  }
</script>
