---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../../../lib/urls';
import { getAvailablePairs } from '../../../../lib/pairLoader';
import { splitAtTerm } from '../../../../lib/glossText';

export async function getStaticPaths() {
  const [pairs, nodes, realisations, exercises] = await Promise.all([
    getAvailablePairs(),
    getCollection('cefr-nodes'),
    getCollection('realisations'),
    getCollection('exercises'),
  ]);
  const nodeIdsWithExercises = new Set(exercises.map((exercise) => exercise.data.lessonId));

  return pairs.flatMap(({ sourceLang, targetLang }) =>
    nodes
      .map((node) => {
        const source = realisations.find(
          (r) => r.data.nodeId === node.data.nodeId && r.data.lang === sourceLang
        );
        const target = realisations.find(
          (r) => r.data.nodeId === node.data.nodeId && r.data.lang === targetLang
        );
        return { node, source, target };
      })
      .filter(({ source, target }) => source && target)
      .map(({ node, source, target }) => ({
        params: { sourceLang, targetLang, nodeId: node.data.nodeId },
        props: {
          node: node.data,
          source: source!.data,
          target: target!.data,
          hasExercises: nodeIdsWithExercises.has(node.data.nodeId),
        },
      }))
  );
}

const { sourceLang, targetLang, nodeId } = Astro.params;
const { node, source, target, hasExercises } = Astro.props;
---

<BaseLayout
  title={`${node.canDo} — ${sourceLang} → ${targetLang}`}
  description={`${node.canDo} — vocabulary, grammar, and cultural notes for this ${node.cefrLevel} lesson.`}
  sourceLang={sourceLang}
  targetLang={targetLang}
>
  <article class="lesson">
    <p class="lesson__meta">
      <span class={`badge badge--${node.cefrLevel.toLowerCase()}`}>{node.cefrLevel}</span>
      <span>{node.skill.replace('_', ' ')} · {nodeId}</span>
    </p>
    <h1 class="lesson__title">{node.canDo}</h1>
    {node.pragmaticFocus && <p class="lesson__focus">{node.pragmaticFocus}</p>}

    <h2>Vocabulary</h2>
    <ul class="vocab-list">
      {
        target.vocabulary.map((targetItem, i) => {
          const sourceItem = source.vocabulary[i];
          return (
            <li class="vocab-item">
              {targetItem.imageUrl && (
                <img
                  class="vocab-item__image"
                  src={withBase(`/vocab-images/${targetItem.imageUrl}`)}
                  alt={targetItem.imageAlt}
                  width="96"
                  height="96"
                  loading="lazy"
                  decoding="async"
                />
              )}
              <div class="vocab-item__body">
                <p class="vocab-item__term">
                  <strong>{targetItem.term}</strong> — {sourceItem?.term ?? targetItem.translation}
                </p>
                <p class="vocab-item__example">
                  {(() => {
                    const gloss = splitAtTerm(targetItem.example, targetItem.term);
                    if (!gloss) return targetItem.example;
                    return (
                      <>
                        {gloss.before}
                        <button type="button" class="gloss" data-gloss={targetItem.translation}>
                          {gloss.match}
                        </button>
                        {gloss.after}
                      </>
                    );
                  })()}
                  <br />
                  <em>{targetItem.exampleTranslation}</em>
                </p>
                {targetItem.mnemonic && (
                  <details class="vocab-item__mnemonic">
                    <summary>Memory aid</summary>
                    <p>{targetItem.mnemonic}</p>
                  </details>
                )}
              </div>
            </li>
          );
        })
      }
    </ul>

    {
      target.grammar.length > 0 && (
        <>
          <h2>Grammar</h2>
          {target.grammar.map((point) => (
            <div class="grammar-point">
              <h3>{point.point}</h3>
              <p>{point.explanation}</p>
              <ul>
                {point.examples.map((example: string) => (
                  <li>{example}</li>
                ))}
              </ul>
            </div>
          ))}
        </>
      )
    }

    {
      target.culturalNotes && (
        <>
          <h2>Cultural notes</h2>
          <p>{target.culturalNotes}</p>
        </>
      )
    }

    <p class="lesson__cta">
      <a href={withBase(`/${sourceLang}/${targetLang}/review/`)}>Practice these words →</a>
      {
        hasExercises && (
          <a href={withBase(`/${sourceLang}/${targetLang}/exercises/${nodeId}/`)}>
            Practice exercises →
          </a>
        )
      }
    </p>
  </article>
</BaseLayout>

<style>
  .lesson {
    max-width: 640px;
  }
  .lesson__meta {
    display: flex;
    align-items: center;
    gap: var(--spacing-unit);
    margin-bottom: calc(var(--spacing-unit) * 2);
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }
  .lesson__focus {
    color: var(--color-text-muted);
    margin-bottom: calc(var(--spacing-unit) * 3);
  }
  .vocab-list {
    display: grid;
    gap: var(--spacing-unit);
    list-style: none;
    padding: 0;
  }
  .vocab-item {
    display: flex;
    gap: calc(var(--spacing-unit) * 2);
    align-items: flex-start;
    padding: calc(var(--spacing-unit) * 2);
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    border-left: 3px solid var(--color-primary);
  }
  .vocab-item__image {
    flex-shrink: 0;
    width: 96px;
    height: 96px;
    object-fit: cover;
    border-radius: var(--radius);
    background-color: var(--color-border);
  }
  .vocab-item__body {
    min-width: 0;
  }
  .vocab-item__term {
    margin-bottom: calc(var(--spacing-unit) * 0.5);
  }
  .vocab-item__example {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    margin-bottom: 0;
  }
  .vocab-item__mnemonic {
    margin-top: calc(var(--spacing-unit) * 0.5);
    font-size: 0.875rem;
  }
  .vocab-item__mnemonic summary {
    cursor: pointer;
    color: var(--color-primary);
  }
  .vocab-item__mnemonic p {
    color: var(--color-text-muted);
    margin: calc(var(--spacing-unit) * 0.5) 0 0;
  }
  .grammar-point {
    margin-bottom: calc(var(--spacing-unit) * 2);
  }
  .lesson__cta {
    margin-top: calc(var(--spacing-unit) * 3);
  }
  .gloss {
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    font: inherit;
    color: inherit;
    cursor: help;
    text-decoration: underline dotted;
    text-decoration-color: var(--color-text-muted);
    text-underline-offset: 3px;
  }
  :global(.gloss-tooltip) {
    position: absolute;
    z-index: 100;
    max-width: 220px;
    padding: calc(var(--spacing-unit) * 0.5) calc(var(--spacing-unit) * 0.75);
    background-color: var(--color-text);
    color: var(--color-bg);
    font-size: 0.8125rem;
    line-height: 1.3;
    border-radius: var(--radius);
    box-shadow: var(--shadow-md);
    pointer-events: none;
  }
</style>

<script>
  // Inline gloss tooltip (#36) — hover/focus/tap shows a term's translation
  // without navigating away or triggering the review flow. One shared
  // tooltip node (not per-.gloss) keeps this cheap on lessons with many
  // vocabulary items.
  const tooltip = document.createElement('div');
  tooltip.className = 'gloss-tooltip';
  tooltip.id = 'gloss-tooltip';
  tooltip.setAttribute('role', 'tooltip');
  tooltip.hidden = true;
  document.body.appendChild(tooltip);

  let activeGloss: HTMLElement | null = null;

  function showGloss(el: HTMLElement) {
    const text = el.dataset.gloss;
    if (!text) return;

    tooltip.textContent = text;
    tooltip.hidden = false;
    activeGloss = el;
    el.setAttribute('aria-describedby', tooltip.id);

    const anchor = el.getBoundingClientRect();
    const box = tooltip.getBoundingClientRect();
    const left = Math.max(
      8,
      Math.min(anchor.left + anchor.width / 2 - box.width / 2, window.innerWidth - box.width - 8)
    );
    const above = anchor.top - box.height - 8;
    const top = above < 0 ? anchor.bottom + 8 : above;
    tooltip.style.left = `${left + window.scrollX}px`;
    tooltip.style.top = `${top + window.scrollY}px`;
  }

  function hideGloss() {
    if (!activeGloss) return;
    activeGloss.removeAttribute('aria-describedby');
    activeGloss = null;
    tooltip.hidden = true;
  }

  for (const el of document.querySelectorAll<HTMLElement>('.gloss')) {
    el.addEventListener('mouseenter', () => showGloss(el));
    el.addEventListener('mouseleave', hideGloss);
    el.addEventListener('focus', () => showGloss(el));
    el.addEventListener('blur', hideGloss);
    // Click fires after focus (mousedown -> focus -> click), so this can't
    // toggle off what focus just showed for the same element — it just
    // (re)shows, which is idempotent. Tapping elsewhere (below) dismisses it,
    // covering touch devices where a tap doesn't always focus a <button>.
    el.addEventListener('click', (e) => {
      e.stopPropagation();
      showGloss(el);
    });
  }

  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('.gloss')) hideGloss();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') hideGloss();
  });
</script>
