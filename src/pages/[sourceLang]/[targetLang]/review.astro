---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { loadPair, getAvailablePairs } from '../../../lib/pairLoader';
import { languageName } from '../../../lib/languageNames';
import { getCollection } from 'astro:content';
import { getString } from '../../../lib/strings';
import { withBase } from '../../../lib/urls';

export async function getStaticPaths() {
  const pairs = await getAvailablePairs();
  return pairs.map(({ sourceLang, targetLang }) => ({ params: { sourceLang, targetLang } }));
}

const { sourceLang, targetLang } = Astro.params;
const items = await loadPair(sourceLang, targetLang);
const targetName = languageName(targetLang);
// First grammar point per node in the target language — shown as corrective
// support when a card is graded "Again" (L10).
const grammarByNode: Record<string, { point: string; explanation: string }> = {};
for (const r of await getCollection('realisations')) {
  const g = r.data.grammar[0];
  if (r.data.lang === targetLang && g) {
    grammarByNode[r.data.nodeId] = { point: g.point, explanation: g.explanation };
  }
}
const canDoByNode: Record<string, string> = {};
const pairNodeIds = new Set(items.map((i) => i.nodeId));
for (const n of await getCollection('cefr-nodes')) {
  if (pairNodeIds.has(n.data.nodeId)) canDoByNode[n.data.nodeId] = n.data.canDo;
}
---

<BaseLayout
  title={`Review ${targetName} — Acquira`}
  description={`Review your due ${targetName} cards with spaced repetition — a few minutes a day for long-term retention.`}
  sourceLang={sourceLang}
  targetLang={targetLang}
  section="review"
>
  <h1>{getString(sourceLang, 'reviewTitle')}</h1>
  <p id="review-intro" class="review-intro">
    {getString(sourceLang, 'reviewIntro')}
  </p>
  <button id="review-direction-toggle" type="button" class="btn btn--secondary">
    {languageName(sourceLang)} → {languageName(targetLang)}
  </button>
  <button id="review-recall-mode-toggle" type="button" class="btn btn--secondary">
    {getString(sourceLang, 'reviewModeReveal')}
  </button>
  <p class="review-mode-hint">
    <strong>{getString(sourceLang, 'reviewHintRevealLabel')}</strong>{' '}
    {getString(sourceLang, 'reviewHintRevealText')}{' '}
    <strong>{getString(sourceLang, 'reviewHintTypeLabel')}</strong>{' '}
    {getString(sourceLang, 'reviewHintTypeText')}
  </p>
  <section
    id="review-intention"
    class="card review-intention"
    aria-labelledby="review-intention-heading"
    hidden
  >
    <p id="review-intention-heading" class="review-intention__heading">
      {getString(sourceLang, 'reviewIntentionHeading')}
    </p>
    <ul id="review-intention-list" class="review-intention__list"></ul>
  </section>
  <p id="review-empty" class="card" hidden>{getString(sourceLang, 'reviewEmpty')}</p>
  <p id="review-no-studied" class="card" hidden>
    {getString(sourceLang, 'reviewNoStudied')}{' '}
    <a
      id="review-first-lesson"
      href={withBase(`/${sourceLang}/${targetLang}/lessons/${items[0]?.nodeId ?? ''}/`)}
      >{getString(sourceLang, 'lessonsStartHere')}</a
    >
  </p>
  <div id="review-card" class="review-card card" hidden>
    <p id="review-progress" class="review-card__progress"></p>
    <img id="review-image" class="review-card__image" hidden />
    <p id="review-front" class="review-card__term"></p>
    <p id="review-cloze-translation" class="review-card__cloze-translation" hidden></p>
    <button id="review-reveal" type="button" class="btn btn--primary">
      {getString(sourceLang, 'reviewRevealButton')}
    </button>
    <form id="review-type-form" class="review-card__type-form" hidden>
      <input
        type="text"
        id="review-type-input"
        class="review-card__type-input"
        autocomplete="off"
        aria-label={getString(sourceLang, 'reviewTypeInputLabel')}
      />
      <button type="submit" class="btn btn--primary"
        >{getString(sourceLang, 'reviewCheckButton')}</button
      >
    </form>
    <p id="review-type-feedback" class="review-card__type-feedback" hidden></p>
    <p id="review-back" class="review-card__term review-card__term--answer" hidden></p>
    <button id="review-pronounce" type="button" class="btn btn--secondary" hidden
      ><svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"
        ><path d="M3 9v6h4l5 4V5L7 9H3zm13.5 3a4.5 4.5 0 0 0-2.5-4v8a4.5 4.5 0 0 0 2.5-4z"
        ></path></svg
      >
      {getString(sourceLang, 'reviewPronounceLabel')}</button
    >
    <p id="review-grade-hint" class="review-mode-hint" hidden>
      {getString(sourceLang, 'reviewGradeHint')}
    </p>
    <div id="review-grades" class="review-card__grades" hidden>
      <button type="button" class="btn btn--grade-again" data-quality="1"
        >{getString(sourceLang, 'reviewGradeAgain')}</button
      >
      <button type="button" class="btn btn--grade-hard" data-quality="2"
        >{getString(sourceLang, 'reviewGradeHard')}</button
      >
      <button type="button" class="btn btn--grade-good" data-quality="3"
        >{getString(sourceLang, 'reviewGradeGood')}</button
      >
      <button type="button" class="btn btn--grade-easy" data-quality="4"
        >{getString(sourceLang, 'reviewGradeEasy')}</button
      >
    </div>
  </div>
  <div id="review-correction" class="card review-correction" role="status" hidden>
    <p class="review-correction__heading">{getString(sourceLang, 'reviewCorrectionHeading')}</p>
    <p id="review-correction-example" class="review-correction__example"></p>
    <p id="review-correction-translation" class="review-correction__translation"></p>
    <p id="review-correction-grammar" class="review-correction__grammar" hidden></p>
    <button id="review-correction-continue" type="button" class="btn btn--primary">
      {getString(sourceLang, 'reviewContinueButton')}
    </button>
  </div>
  <p id="review-summary" class="card" hidden></p>
  <nav id="review-next" class="card review-next" aria-labelledby="review-next-heading" hidden>
    <p id="review-next-heading" class="review-next__heading">
      {getString(sourceLang, 'reviewNextHeading')}
    </p>
    <div class="review-next__actions">
      <button id="review-practice-more" type="button" class="btn btn--primary">
        {getString(sourceLang, 'reviewPracticeMore')}
      </button>
      <a class="btn btn--secondary" href={withBase(`/${sourceLang}/${targetLang}/lessons/`)}
        >{getString(sourceLang, 'navLessons')}</a
      >
      <a class="btn btn--secondary" href={withBase(`/${sourceLang}/${targetLang}/progress/`)}
        >{getString(sourceLang, 'navProgress')}</a
      >
    </div>
  </nav>
  <div id="review-reflection" class="card review-reflection" hidden>
    <p>{getString(sourceLang, 'reviewReflectionQuestion')}</p>
    <div class="review-reflection__options">
      <button type="button" class="btn btn--secondary" data-response="easy"
        >{getString(sourceLang, 'reviewReflectionEasy')}</button
      >
      <button type="button" class="btn btn--secondary" data-response="had-to-think"
        >{getString(sourceLang, 'reviewReflectionThink')}</button
      >
      <button type="button" class="btn btn--secondary" data-response="guessed"
        >{getString(sourceLang, 'reviewReflectionGuessed')}</button
      >
    </div>
    <button type="button" id="review-reflection-skip" class="btn btn--secondary">
      {getString(sourceLang, 'reviewReflectionSkip')}
    </button>
  </div>
  <p id="review-reflection-thanks" class="review-reflection__thanks" hidden></p>

  <p id="review-plan" class="review-plan" hidden></p>
  <form id="review-nextform" class="card review-nextform" hidden>
    <label for="review-nextform-text">{getString(sourceLang, 'nextSessionQuestion')}</label>
    <input id="review-nextform-text" type="text" maxlength="120" autocomplete="off" />
    <label for="review-nextform-time">{getString(sourceLang, 'nextSessionTime')}</label>
    <input id="review-nextform-time" type="time" value="08:00" />
    <div class="review-reflection__options">
      <button type="submit" class="btn btn--primary"
        >{getString(sourceLang, 'nextSessionSave')}</button
      >
      <button type="button" id="review-nextform-ics" class="btn btn--secondary">
        {getString(sourceLang, 'nextSessionCalendar')}
      </button>
      <button type="button" id="review-nextform-skip" class="btn btn--secondary">
        {getString(sourceLang, 'reviewReflectionSkip')}
      </button>
    </div>
  </form>

  <script
    type="application/json"
    id="review-data"
    set:html={JSON.stringify({ sourceLang, targetLang, items, grammarByNode, canDoByNode })}
  />
</BaseLayout>

<style>
  .review-intro {
    color: var(--color-text-muted);
    max-width: 60ch;
    margin-bottom: calc(var(--spacing-unit) * 2);
  }
  .review-mode-hint {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    max-width: 60ch;
    margin: calc(var(--spacing-unit) * 1.5) 0 calc(var(--spacing-unit) * 2);
  }
  .review-card {
    max-width: 420px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(var(--spacing-unit) * 2);
  }
  .review-card__progress {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    margin: 0;
  }
  .review-card__image {
    width: 160px;
    height: 160px;
    object-fit: cover;
    border-radius: var(--radius);
    background-color: var(--color-bg-secondary);
  }
  .review-card__term {
    font-size: 2rem;
    font-weight: 700;
    margin: 0;
  }
  .review-card__cloze-translation {
    color: var(--color-text-muted);
    margin: 0;
  }
  .review-card__term--answer {
    color: var(--color-primary);
  }
  .review-card__grades {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--spacing-unit);
  }
  @media (max-width: 480px) {
    .review-card__grades {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .review-intention {
    max-width: 420px;
  }
  .review-intention__heading {
    font-weight: 600;
    margin-top: 0;
  }
  .review-intention__list {
    margin: 0;
    padding-left: calc(var(--spacing-unit) * 2.5);
  }
  .review-correction {
    max-width: 420px;
    text-align: center;
  }
  .review-correction__heading {
    font-weight: 600;
    margin-top: 0;
  }
  .review-correction__example {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0;
  }
  .review-correction__translation,
  .review-correction__grammar {
    color: var(--color-text-muted);
    margin: var(--spacing-unit) 0;
  }
  .review-next__heading {
    font-weight: 600;
    margin-top: 0;
  }
  .review-next__actions {
    display: flex;
    gap: var(--spacing-unit);
    flex-wrap: wrap;
  }
  .review-reflection {
    text-align: center;
  }
  .review-reflection__options {
    display: flex;
    gap: var(--spacing-unit);
    flex-wrap: wrap;
    justify-content: center;
    margin-block: calc(var(--spacing-unit) * 1.5);
  }
  .review-nextform {
    display: grid;
    gap: var(--spacing-unit);
  }
  .review-plan {
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }
  .review-reflection__thanks {
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }
  .review-card__type-form {
    display: flex;
    gap: var(--spacing-unit);
    flex-wrap: wrap;
    justify-content: center;
  }
  .review-card__type-input {
    padding: calc(var(--spacing-unit) * 0.75);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    font-size: 1.25rem;
  }
  .review-card__type-feedback {
    font-weight: 600;
    margin: 0;
  }
  .review-card__type-feedback--correct {
    color: var(--color-success, #1a7f37);
  }
  .review-card__diff {
    background: var(--color-error, #cf222e);
    color: white;
    border-radius: 2px;
    padding: 0 1px;
  }
  .review-card__grades [data-suggested] {
    outline: 3px solid var(--color-text, #1a1a1a);
    outline-offset: 2px;
  }
  .review-card__type-feedback--incorrect {
    color: var(--color-error, #cf222e);
  }
</style>

<script>
  import {
    loadState,
    saveState,
    hasState,
    loadNewCap,
    loadStudied,
    loadIntroducedToday,
    recordIntroduced,
    loadDirectionPreference,
    saveDirectionPreference,
    loadRecallModePreference,
    saveRecallModePreference,
    type ReviewDirection,
    type RecallMode,
  } from '../../../lib/storage';
  import { calculateNextReview, isDue } from '../../../utils/srs';
  import { pronounce, recordedAudioPath } from '../../../lib/pronounce';
  import { languageName } from '../../../lib/languageNames';
  import {
    DAILY_NEW_CAP,
    RELEARN_CRITERION,
    nextRemaining,
    selectDue,
  } from '../../../lib/reviewSession';
  import { withBase } from '../../../lib/urls';
  import { computeOverallMastery } from '../../../lib/progress';
  import {
    saveIntention,
    loadIntention,
    markCalendarUsed,
    buildIcs,
  } from '../../../lib/nextSession';
  import { saveReflection, loadReflection, type ReflectionResponse } from '../../../lib/reflection';
  import { diffAnswer, suggestGrade } from '../../../lib/exerciseCheck';
  import { makeCloze, shouldCloze } from '../../../lib/cloze';
  import { recordGradeForCalibration } from '../../../lib/calibration';
  import { appendGrade } from '../../../lib/gradeLog';
  import { getString, format } from '../../../lib/strings';

  interface PairSide {
    id: string;
    term: string;
    imageUrl?: string;
    imageAlt?: string;
    example: string;
    exampleTranslation: string;
  }

  interface PairItem {
    nodeId: string;
    concept: string;
    source: PairSide;
    target: PairSide;
  }

  const dataEl = document.getElementById('review-data');
  const { sourceLang, targetLang, items, grammarByNode, canDoByNode } = JSON.parse(
    dataEl?.textContent ?? '{}'
  ) as {
    sourceLang: string;
    targetLang: string;
    items: PairItem[];
    grammarByNode: Record<string, { point: string; explanation: string }>;
    canDoByNode: Record<string, string>;
  };

  // Quality maps 1-4 (Again/Hard/Good/Easy) to SM-2's 0-5 scale (spec §6.3).
  const qualityToSm2: Record<number, number> = { 1: 1, 2: 3, 3: 4, 4: 5 };

  let direction: ReviewDirection = loadDirectionPreference(sourceLang, targetLang);
  // Reveal (recognition) vs type-the-answer-first (issue #45, the generation
  // effect) — opt-in per language pair, defaulting to today's reveal flow.
  let recallMode: RecallMode = loadRecallModePreference(sourceLang, targetLang);
  let queue: PairItem[] = [];
  let reviewed = 0;
  // Items already re-queued once after an "Again" grade this session — capped
  // to one retry per item so a repeatedly-failed card can't loop forever.
  let requeuedIds = new Set<string>();
  // L23: new words stay in the session until recalled correctly (criterion).
  let criterionLeft = new Map<string, number>();
  // Calibration signal (spec §1.1, desirable difficulties): first-attempt
  // accuracy and the mastery delta over the whole vocabulary, shown at
  // session end instead of only on the separate /progress page.
  let firstTryTotal = 0;
  let firstTryCorrect = 0;
  let masteryBefore = 0;

  function snapshotMasteryPercent(): number {
    const repetitionsList = items.map((item) => ({
      repetitions: loadState(sourceLang, targetLang, direction, item.target.id).repetitions,
    }));
    return computeOverallMastery(repetitionsList).percent;
  }

  const cardEl = document.getElementById('review-card')!;
  const emptyEl = document.getElementById('review-empty')!;
  const noStudiedEl = document.getElementById('review-no-studied')!;
  const summaryEl = document.getElementById('review-summary')!;
  const nextEl = document.getElementById('review-next')!;
  const practiceMoreBtn = document.getElementById('review-practice-more')!;
  const progressEl = document.getElementById('review-progress')!;
  const imageEl = document.getElementById('review-image') as HTMLImageElement;
  const frontEl = document.getElementById('review-front')!;
  const backEl = document.getElementById('review-back')!;
  const clozeTranslationEl = document.getElementById('review-cloze-translation')!;
  const revealBtn = document.getElementById('review-reveal')!;
  const pronounceBtn = document.getElementById('review-pronounce')!;
  const gradesEl = document.getElementById('review-grades')!;
  const gradeHintEl = document.getElementById('review-grade-hint')!;
  const directionToggle = document.getElementById('review-direction-toggle')!;
  const recallModeToggle = document.getElementById('review-recall-mode-toggle')!;
  const typeFormEl = document.getElementById('review-type-form') as HTMLFormElement;
  const typeInputEl = document.getElementById('review-type-input') as HTMLInputElement;
  const typeFeedbackEl = document.getElementById('review-type-feedback')!;
  const correctionEl = document.getElementById('review-correction')!;
  const correctionExampleEl = document.getElementById('review-correction-example')!;
  const correctionTranslationEl = document.getElementById('review-correction-translation')!;
  const correctionGrammarEl = document.getElementById('review-correction-grammar')!;
  const correctionContinueBtn = document.getElementById('review-correction-continue')!;
  const reflectionEl = document.getElementById('review-reflection')!;
  const reflectionThanksEl = document.getElementById('review-reflection-thanks')!;
  const reflectionSkipBtn = document.getElementById('review-reflection-skip')!;

  function todayKey(): string {
    return new Date().toISOString().slice(0, 10);
  }

  function reflectionLabel(response: ReflectionResponse): string {
    if (response === 'easy') return getString(sourceLang, 'reviewReflectionLabelEasy');
    if (response === 'had-to-think') return getString(sourceLang, 'reviewReflectionLabelThink');
    return getString(sourceLang, 'reviewReflectionLabelGuessed');
  }

  function hideReflection(): void {
    reflectionEl.hidden = true;
    reflectionThanksEl.hidden = true;
  }

  function showReflectionPrompt(): void {
    const existing = loadReflection(sourceLang, targetLang, todayKey());
    if (existing) {
      reflectionEl.hidden = true;
      reflectionThanksEl.hidden = false;
      reflectionThanksEl.textContent = format(getString(sourceLang, 'reviewReflectionThanks'), {
        label: reflectionLabel(existing),
      });
    } else {
      reflectionEl.hidden = false;
      reflectionThanksEl.hidden = true;
    }
  }

  reflectionEl.querySelectorAll<HTMLButtonElement>('[data-response]').forEach((button) => {
    button.addEventListener('click', () => {
      const response = button.dataset.response as ReflectionResponse;
      saveReflection(sourceLang, targetLang, response, todayKey());
      reflectionEl.hidden = true;
      reflectionThanksEl.hidden = false;
      reflectionThanksEl.textContent = format(getString(sourceLang, 'reviewReflectionThanks'), {
        label: reflectionLabel(response),
      });
    });
  });

  reflectionSkipBtn.addEventListener('click', () => {
    reflectionEl.hidden = true;
  });

  const planEl = document.getElementById('review-plan')!;
  const nextFormEl = document.getElementById('review-nextform') as HTMLFormElement;
  const nextFormText = document.getElementById('review-nextform-text') as HTMLInputElement;
  const nextFormTime = document.getElementById('review-nextform-time') as HTMLInputElement;

  function showPlan(): boolean {
    const saved = loadIntention(sourceLang, targetLang);
    planEl.hidden = !saved;
    if (saved) {
      planEl.textContent = format(getString(sourceLang, 'nextSessionSaved'), { plan: saved.text });
    }
    return saved !== null;
  }

  function showNextFormPrompt(): void {
    nextFormEl.hidden = showPlan();
  }

  nextFormEl.addEventListener('submit', (event) => {
    event.preventDefault();
    saveIntention(sourceLang, targetLang, nextFormText.value, todayKey());
    nextFormEl.hidden = showPlan();
  });
  document.getElementById('review-nextform-skip')!.addEventListener('click', () => {
    nextFormEl.hidden = true;
  });
  // Generated on-device from a Blob: no network request (spec L21).
  document.getElementById('review-nextform-ics')!.addEventListener('click', () => {
    if (!nextFormText.value.trim()) {
      nextFormText.focus();
      return;
    }
    saveIntention(sourceLang, targetLang, nextFormText.value, todayKey());
    markCalendarUsed(sourceLang, targetLang);
    const link = document.createElement('a');
    link.href = URL.createObjectURL(
      new Blob([buildIcs(nextFormText.value.trim(), nextFormTime.value || '08:00')], {
        type: 'text/calendar',
      })
    );
    link.download = 'acquira-next-session.ics';
    link.click();
    setTimeout(() => URL.revokeObjectURL(link.href), 1000);
    nextFormEl.hidden = showPlan();
  });
  showPlan();

  function frontOf(item: PairItem) {
    return direction === 'forward' ? item.source : item.target;
  }
  function backOf(item: PairItem) {
    return direction === 'forward' ? item.target : item.source;
  }
  function backLang(): string {
    return direction === 'forward' ? targetLang : sourceLang;
  }
  // The image lives on whichever side of the pair happens to have one (in
  // practice the target-language vocabulary item) — independent of which
  // side is currently "front" vs "back", since it's a memory cue for the
  // concept, not tied to review direction.
  function imageOf(item: PairItem): PairSide | undefined {
    if (item.source.imageUrl) return item.source;
    if (item.target.imageUrl) return item.target;
    return undefined;
  }

  function updateDirectionToggle(): void {
    directionToggle.textContent =
      direction === 'forward'
        ? `${languageName(sourceLang)} → ${languageName(targetLang)}`
        : `${languageName(targetLang)} → ${languageName(sourceLang)}`;
  }

  function updateRecallModeToggle(): void {
    recallModeToggle.textContent =
      recallMode === 'type'
        ? getString(sourceLang, 'reviewModeType')
        : recallMode === 'picture'
          ? getString(sourceLang, 'reviewModePicture')
          : getString(sourceLang, 'reviewModeReveal');
  }

  function buildQueue(): void {
    queue = selectDue(items, {
      studied: loadStudied(sourceLang, targetLang),
      scope: new URLSearchParams(window.location.search).get('lesson') ?? undefined,
      isNew: (item) => !hasState(sourceLang, targetLang, direction, item.target.id),
      isDue: (item) => isDue(loadState(sourceLang, targetLang, direction, item.target.id)),
      introducedToday: loadIntroducedToday(sourceLang, targetLang, todayKey()),
      cap: loadNewCap(sourceLang, targetLang, DAILY_NEW_CAP),
    });
    reviewed = 0;
    requeuedIds = new Set<string>();
    criterionLeft = new Map(
      queue
        .filter((i) => !hasState(sourceLang, targetLang, direction, i.target.id))
        .map((i) => [i.target.id, RELEARN_CRITERION])
    );
    firstTryTotal = 0;
    firstTryCorrect = 0;
    masteryBefore = snapshotMasteryPercent();
  }

  function showCard(): void {
    const item = queue[0];
    if (!item) {
      cardEl.hidden = true;
      nextEl.hidden = false;
      summaryEl.hidden = false;
      const masteryAfter = snapshotMasteryPercent();
      const masteryDelta = masteryAfter - masteryBefore;
      const deltaText =
        masteryDelta > 0
          ? format(getString(sourceLang, 'reviewMasteryUp'), { n: masteryDelta })
          : masteryDelta < 0
            ? format(getString(sourceLang, 'reviewMasteryDown'), { n: -masteryDelta })
            : getString(sourceLang, 'reviewMasteryUnchanged');
      summaryEl.textContent = format(getString(sourceLang, 'reviewSessionComplete'), {
        reviewed,
        cardWord: getString(sourceLang, reviewed === 1 ? 'cardSingular' : 'cardPlural'),
        correct: firstTryCorrect,
        total: firstTryTotal,
        delta: deltaText,
        after: masteryAfter,
      });
      showReflectionPrompt();
      showNextFormPrompt();
      return;
    }
    hideReflection();
    nextFormEl.hidden = true;
    nextEl.hidden = true;
    correctionEl.hidden = true;
    progressEl.textContent = format(getString(sourceLang, 'reviewProgress'), {
      current: reviewed + 1,
      total: reviewed + queue.length,
    });
    const image = imageOf(item);
    if (image?.imageUrl) {
      imageEl.src = withBase(`/vocab-images/${image.imageUrl}`);
      imageEl.alt = image.imageAlt ?? '';
      imageEl.hidden = false;
    } else {
      imageEl.hidden = true;
    }
    frontEl.textContent = frontOf(item).term;
    backEl.textContent = backOf(item).term;
    backEl.hidden = true;
    pronounceBtn.hidden = true;
    gradesEl.hidden = true;
    gradeHintEl.hidden = true;
    typeInputEl.value = '';
    typeInputEl.disabled = false;
    typeFeedbackEl.hidden = true;
    gradesEl
      .querySelectorAll('[data-suggested]')
      .forEach((b) => b.removeAttribute('data-suggested'));

    const picturePrompt = recallMode === 'picture' && !!image?.imageUrl;
    if (recallMode === 'type') {
      revealBtn.hidden = true;
      typeFormEl.hidden = false;
      frontEl.hidden = false;
      imageEl.hidden = true;
      frontEl.textContent = frontOf(item).term;
    } else if (picturePrompt) {
      revealBtn.hidden = true;
      typeFormEl.hidden = false;
      frontEl.hidden = true;
      imageEl.hidden = false;
    } else {
      revealBtn.hidden = false;
      typeFormEl.hidden = true;
      frontEl.hidden = false;
      imageEl.hidden = true;
      frontEl.textContent = frontOf(item).term;
    }

    // L24: a mature item alternates with a cloze of its own example sentence —
    // the answer term blanked, its translation as the cue. Same SRS state and
    // grading; items whose term isn't verbatim in the sentence stay plain.
    clozeTranslationEl.hidden = true;
    if (!picturePrompt) {
      const answer = backOf(item);
      const { repetitions } = loadState(sourceLang, targetLang, direction, item.target.id);
      const cloze = shouldCloze(repetitions) ? makeCloze(answer.example, answer.term) : null;
      if (cloze) {
        frontEl.textContent = cloze;
        frontEl.hidden = false;
        clozeTranslationEl.textContent = answer.exampleTranslation;
        clozeTranslationEl.hidden = false;
      }
    }
  }

  // L11: state the session's learning intention — the Can-Do statements the
  // due cards serve — before the first card ("Where am I going?").
  function renderIntention(): void {
    const intentionEl = document.getElementById('review-intention')!;
    const canDos = [...new Set(queue.map((i) => canDoByNode[i.nodeId]).filter(Boolean))];
    // Cap the list so a big queue can't push the first card below the fold.
    const shown = canDos.slice(0, 3);
    if (canDos.length > shown.length) shown.push(`+${canDos.length - shown.length}`);
    document
      .getElementById('review-intention-list')!
      .replaceChildren(
        ...shown.map((text) => Object.assign(document.createElement('li'), { textContent: text }))
      );
    intentionEl.hidden = canDos.length === 0;
  }

  function renderQueueState(): void {
    renderIntention();
    if (queue.length === 0) {
      cardEl.hidden = true;
      summaryEl.hidden = true;
      nextEl.hidden = false;
      hideReflection();
      const nothingStudied =
        loadStudied(sourceLang, targetLang).size === 0 &&
        !window.location.search.includes('lesson=');
      noStudiedEl.hidden = !nothingStudied;
      emptyEl.hidden = nothingStudied;
    } else {
      emptyEl.hidden = true;
      noStudiedEl.hidden = true;
      summaryEl.hidden = true;
      cardEl.hidden = false;
      showCard();
    }
  }

  revealBtn.addEventListener('click', () => {
    backEl.hidden = false;
    pronounceBtn.hidden = false;
    gradesEl.hidden = false;
    gradeHintEl.hidden = false;
  });

  typeFormEl.addEventListener('submit', (event) => {
    event.preventDefault();
    if (typeInputEl.disabled) return;
    const item = queue[0];
    if (!item) return;

    // Typed-vs-correct is a hint for the learner's own self-grade below, not
    // an automatic grade override — SM-2 grading stays learner-driven either
    // way (issue #45's explicit requirement).
    const answer = backOf(item).term;
    const suggestion = suggestGrade(typeInputEl.value, answer);
    typeInputEl.disabled = true;
    typeFeedbackEl.hidden = false;
    typeFeedbackEl.className = `review-card__type-feedback review-card__type-feedback--${suggestion === 'good' ? 'correct' : 'incorrect'}`;
    typeFeedbackEl.textContent = getString(
      sourceLang,
      suggestion === 'good'
        ? 'reviewCorrect'
        : suggestion === 'hard'
          ? 'reviewAccentMiss'
          : 'reviewIncorrect'
    );
    // L26: highlight the characters the attempt missed in the revealed answer.
    if (suggestion !== 'good') {
      backEl.replaceChildren(
        ...diffAnswer(typeInputEl.value, answer).map(({ char, wrong }) => {
          if (!wrong) return document.createTextNode(char);
          return Object.assign(document.createElement('mark'), {
            className: 'review-card__diff',
            textContent: char,
          });
        })
      );
    }
    // ...and pre-select (not force) a grade; the learner can still change it.
    const suggestedQuality = { again: '1', hard: '2', good: '3' }[suggestion];
    gradesEl.querySelectorAll('button[data-quality]').forEach((b) => {
      const isSuggested = (b as HTMLElement).dataset.quality === suggestedQuality;
      b.toggleAttribute('data-suggested', isSuggested);
      if (isSuggested) (b as HTMLElement).focus();
    });
    backEl.hidden = false;
    pronounceBtn.hidden = false;
    gradesEl.hidden = false;
    gradeHintEl.hidden = false;
  });

  pronounceBtn.addEventListener('click', () => {
    const item = queue[0];
    if (!item) return;
    const back = backOf(item);
    const path = recordedAudioPath(backLang(), back.id);
    pronounce(back.term, backLang(), path && withBase(path));
  });

  gradesEl.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest('button[data-quality]');
    if (!button) return;

    const item = queue.shift();
    if (!item) return;

    const uiQuality = Number(button.getAttribute('data-quality'));
    recordGradeForCalibration(
      sourceLang,
      targetLang,
      direction,
      item.target.id,
      uiQuality,
      todayKey()
    );
    appendGrade(sourceLang, targetLang, {
      item: item.target.id,
      dir: direction,
      q: uiQuality,
      d: todayKey(),
    });
    const quality = qualityToSm2[uiQuality];
    const isFirstAttempt = !requeuedIds.has(item.target.id);
    if (isFirstAttempt) {
      firstTryTotal += 1;
      if (quality >= 3) firstTryCorrect += 1;
    }
    if (!hasState(sourceLang, targetLang, direction, item.target.id)) {
      recordIntroduced(sourceLang, targetLang, todayKey());
    }
    const state = loadState(sourceLang, targetLang, direction, item.target.id);
    const nextState = calculateNextReview({ state, quality });
    saveState(sourceLang, targetLang, direction, item.target.id, nextState);

    // A failed recall ("Again") reappears a few cards later in this same
    // session for another retrieval attempt, rather than waiting for its
    // SM-2 due date tomorrow. Only once per item, so a repeat "Again" can't
    // loop the session forever.
    const remaining = criterionLeft.get(item.target.id);
    // Only a return visit counts: the first showing introduces the word, so the
    // criterion is a correct recall after at least one intervening card (L23).
    if (remaining !== undefined && requeuedIds.has(item.target.id)) {
      criterionLeft.set(item.target.id, nextRemaining(remaining, quality >= 3));
    }
    const needsRelearn = (criterionLeft.get(item.target.id) ?? 0) > 0;
    if (needsRelearn || (quality < 3 && !requeuedIds.has(item.target.id))) {
      requeuedIds.add(item.target.id);
      queue.splice(Math.min(3, queue.length), 0, item);
    } else {
      reviewed += 1;
    }
    if (quality < 3) {
      showCorrection(item);
    } else {
      showCard();
    }
  });

  // L10: before an "Again" card is re-queued, show its example sentence,
  // translation and any grammar note — not just the bare answer again.
  function showCorrection(item: PairItem): void {
    const back = backOf(item);
    const front = frontOf(item);
    correctionExampleEl.textContent = back.example;
    correctionTranslationEl.textContent = front.example;
    const grammar = grammarByNode[item.nodeId];
    correctionGrammarEl.hidden = !grammar;
    correctionGrammarEl.textContent = grammar ? `${grammar.point}: ${grammar.explanation}` : '';
    cardEl.hidden = true;
    correctionEl.hidden = false;
    correctionContinueBtn.focus();
  }

  correctionContinueBtn.addEventListener('click', () => {
    correctionEl.hidden = true;
    cardEl.hidden = false;
    showCard();
  });

  practiceMoreBtn.addEventListener('click', () => {
    buildQueue();
    renderQueueState();
  });

  directionToggle.addEventListener('click', () => {
    direction = direction === 'forward' ? 'reverse' : 'forward';
    saveDirectionPreference(sourceLang, targetLang, direction);
    updateDirectionToggle();
    buildQueue();
    renderQueueState();
  });

  recallModeToggle.addEventListener('click', () => {
    if (recallMode === 'reveal') {
      recallMode = 'type';
    } else if (recallMode === 'type') {
      recallMode = 'picture';
    } else {
      recallMode = 'reveal';
    }
    saveRecallModePreference(sourceLang, targetLang, recallMode);
    updateRecallModeToggle();
    // Reset the current card's controls for the new mode without losing
    // session progress (unlike direction, mode doesn't change which cards
    // are due, so no need to rebuild the queue).
    if (queue.length > 0) showCard();
  });

  updateDirectionToggle();
  updateRecallModeToggle();
  buildQueue();
  renderQueueState();
</script>
