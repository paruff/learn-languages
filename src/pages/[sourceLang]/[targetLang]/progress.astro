---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getAvailablePairs, loadPair } from '../../../lib/pairLoader';
import { languageName } from '../../../lib/languageNames';
import { getString } from '../../../lib/strings';

export async function getStaticPaths() {
  const pairs = await getAvailablePairs();
  return pairs.map(({ sourceLang, targetLang }) => ({ params: { sourceLang, targetLang } }));
}

const { sourceLang, targetLang } = Astro.params;
const [items, nodes] = await Promise.all([
  loadPair(sourceLang, targetLang),
  getCollection('cefr-nodes'),
]);

const nodeMeta = new Map(nodes.map((n) => [n.data.nodeId, n.data]));

const trackedItems = items
  .filter((item) => nodeMeta.has(item.nodeId))
  .map((item) => {
    const node = nodeMeta.get(item.nodeId)!;
    return {
      itemId: item.target.id,
      nodeId: item.nodeId,
      cefrLevel: node.cefrLevel,
      canDo: node.canDo,
    };
  });

const targetName = languageName(targetLang);
---

<BaseLayout
  title={`${targetName} Progress — Acquira`}
  description={`Track your ${targetName} mastery by CEFR level, with calibration feedback on how reliable your self-assessments have been.`}
  sourceLang={sourceLang}
  targetLang={targetLang}
  section="progress"
>
  <h1>{getString(sourceLang, 'progressTitle')}</h1>
  <div id="progress-levels"></div>
  <p id="progress-next" class="card" hidden></p>
  <p id="progress-calibration" class="card" hidden></p>

  <section class="card backup" id="backup" aria-labelledby="backup-title" hidden>
    <h2 id="backup-title">{getString(sourceLang, 'backupTitle')}</h2>
    <p>{getString(sourceLang, 'backupHint')}</p>
    <div class="backup__actions">
      <button type="button" class="btn" id="backup-export"
        >{getString(sourceLang, 'backupExport')}</button
      >
      <label class="btn backup__import">
        {getString(sourceLang, 'backupImport')}
        <input type="file" id="backup-import" accept="application/json,.json" />
      </label>
    </div>
    <p id="backup-status" role="status" aria-live="polite"></p>
  </section>

  <script
    type="application/json"
    id="progress-data"
    set:html={JSON.stringify({ sourceLang, targetLang, trackedItems })}
  />
</BaseLayout>

<style>
  .progress-level {
    margin-bottom: calc(var(--spacing-unit) * 2);
  }
  .backup__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-unit);
  }
  .backup__import {
    position: relative;
  }
  .backup__import input {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
  }
  .backup__import:focus-within {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
  .progress-level__label {
    display: flex;
    justify-content: space-between;
    font-weight: 600;
    margin-bottom: calc(var(--spacing-unit) * 0.5);
  }
</style>

<script>
  import { loadState, exportProgress, importProgress } from '../../../lib/storage';
  import { computeCefrProgress, type TrackedItem } from '../../../lib/progress';
  import { loadBreakDates, countRecentBreaks } from '../../../lib/calibration';
  import { getString, format } from '../../../lib/strings';

  interface DataItem {
    itemId: string;
    nodeId: string;
    cefrLevel: string;
    canDo: string;
  }

  const dataEl = document.getElementById('progress-data');
  const { sourceLang, targetLang, trackedItems } = JSON.parse(dataEl?.textContent ?? '{}') as {
    sourceLang: string;
    targetLang: string;
    trackedItems: DataItem[];
  };

  const items: TrackedItem[] = trackedItems.map((item) => ({
    ...item,
    repetitions: loadState(sourceLang, targetLang, 'forward', item.itemId).repetitions,
  }));

  const { levels, nextRecommended } = computeCefrProgress(items);

  const masteredLabel = getString(sourceLang, 'progressMastered');
  const levelsEl = document.getElementById('progress-levels')!;
  levelsEl.innerHTML = levels.length
    ? levels
        .map(
          (l) => `
      <div class="progress-level">
        <p class="progress-level__label">
          <span class="badge badge--${l.cefrLevel.toLowerCase()}">${l.cefrLevel}</span>
          <span>${l.masteredItems}/${l.totalItems} ${masteredLabel}</span>
        </p>
        <div class="progress-bar"><div class="progress-bar__fill" style="width: ${l.percent}%"></div></div>
      </div>`
        )
        .join('')
    : `<p>${getString(sourceLang, 'progressNoContent')}</p>`;

  const nextEl = document.getElementById('progress-next')!;
  nextEl.textContent = nextRecommended
    ? format(getString(sourceLang, 'progressNextUp'), {
        canDo: nextRecommended.canDo,
        level: nextRecommended.cefrLevel,
      })
    : getString(sourceLang, 'progressAllMastered');

  // Revealed in the same task that renders the levels above them, so they
  // never shift after first paint (CLS) and stay hidden when JS is unavailable.
  nextEl.hidden = false;
  document.getElementById('backup')!.hidden = false;

  // Calibration signal (issue #46) — the book's "fluency illusion" warning:
  // learners are poor judges of their own mastery. Surfaces how often a
  // confident Good/Easy grade was followed by a struggling Again/Hard grade
  // within the last week, computed from real grading history, not a guess.
  const recentBreaks = countRecentBreaks(loadBreakDates(sourceLang, targetLang), new Date());
  const calibrationEl = document.getElementById('progress-calibration')!;
  if (recentBreaks > 0) {
    calibrationEl.hidden = false;
    calibrationEl.textContent = format(getString(sourceLang, 'progressCalibration'), {
      n: recentBreaks,
      itemWord: getString(sourceLang, recentBreaks === 1 ? 'itemSingular' : 'itemPlural'),
    });
  }

  // Backup/restore (spec S5) — progress lives only in localStorage, so this is
  // the learner's only protection against clearing browser data.
  document.getElementById('backup-export')?.addEventListener('click', () => {
    const blob = new Blob([JSON.stringify(exportProgress(), null, 2)], {
      type: 'application/json',
    });
    const link = document.createElement('a');
    link.href = URL.createObjectURL(blob);
    link.download = `acquira-backup-${new Date().toISOString().slice(0, 10)}.json`;
    link.click();
    URL.revokeObjectURL(link.href);
  });

  const statusEl = document.getElementById('backup-status')!;
  document.getElementById('backup-import')?.addEventListener('change', async (event) => {
    const input = event.currentTarget as HTMLInputElement;
    const file = input.files?.[0];
    if (!file) return;
    const result = importProgress(await file.text());
    input.value = '';
    if (!result.ok) {
      statusEl.textContent = getString(sourceLang, 'backupImportFailed');
      return;
    }
    statusEl.textContent = format(getString(sourceLang, 'backupImported'), { n: result.count });
    // Re-render levels/next-up from the restored state.
    setTimeout(() => window.location.reload(), 1200);
  });
</script>
