---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getAvailablePairs, loadPair } from '../../../lib/pairLoader';
import { languageName } from '../../../lib/languageNames';
import { getString } from '../../../lib/strings';
import { orderLessons } from '../../../lib/path';
import ContinueCard from '../../../components/ContinueCard.astro';

export async function getStaticPaths() {
  const pairs = await getAvailablePairs();
  return pairs.map(({ sourceLang, targetLang }) => ({ params: { sourceLang, targetLang } }));
}

const { sourceLang, targetLang } = Astro.params;
const [items, nodes] = await Promise.all([
  loadPair(sourceLang, targetLang),
  getCollection('cefr-nodes'),
]);

const nodeMeta = new Map(nodes.map((n) => [n.data.nodeId, n.data]));

const trackedItems = items
  .filter((item) => nodeMeta.has(item.nodeId))
  .map((item) => {
    const node = nodeMeta.get(item.nodeId)!;
    return {
      itemId: item.target.id,
      nodeId: item.nodeId,
      cefrLevel: node.cefrLevel,
      canDo: node.canDo,
    };
  });

const a1Path = orderLessons(
  nodes
    .filter((n) => n.data.cefrLevel === 'A1' && items.some((i) => i.nodeId === n.data.nodeId))
    .map((n) => n.data)
);
const targetName = languageName(targetLang);
---

<BaseLayout
  title={`${targetName} Progress — Acquira`}
  description={`Track your ${targetName} mastery by CEFR level, with calibration feedback on how reliable your self-assessments have been.`}
  sourceLang={sourceLang}
  targetLang={targetLang}
  section="progress"
>
  <h1>{getString(sourceLang, 'progressTitle')}</h1>
  <ContinueCard sourceLang={sourceLang} targetLang={targetLang} lessons={a1Path} />
  <section id="progress-cando" aria-label="What you can do"></section>
  <div id="progress-levels"></div>
  <p id="progress-next" class="card" hidden></p>
  <p id="progress-calibration" class="card" hidden></p>

  <!-- ponytail: English-only tester-facing copy for M1/M2; localise if this outlives the first test rounds. -->
  <section class="card" id="retention" aria-labelledby="retention-title" hidden>
    <h2 id="retention-title">Remembering over time</h2>
    <p id="retention-text"></p>
  </section>

  <section class="card report" id="report" aria-labelledby="report-title" hidden>
    <h2 id="report-title">Share how it went</h2>
    <p>
      Helping test Acquira? This builds a short summary of your practice (counts and dates only, no
      words or personal details). You read it, then you choose whether to send it.
    </p>
    <label for="report-comment">Anything you'd like to tell us? (optional)</label>
    <textarea id="report-comment" rows="3"></textarea>
    <div class="backup__actions">
      <a class="btn" id="report-email" href="mailto:">Email my report</a>
      <button type="button" class="btn" id="report-copy">Copy my report</button>
    </div>
    <details>
      <summary>See exactly what will be sent</summary>
      <pre id="report-preview" class="report__preview"></pre>
    </details>
    <p id="report-status" role="status" aria-live="polite"></p>
  </section>

  <section class="card backup" id="backup" aria-labelledby="backup-title" hidden>
    <h2 id="backup-title">{getString(sourceLang, 'backupTitle')}</h2>
    <p>{getString(sourceLang, 'backupHint')}</p>
    <div class="backup__actions">
      <button type="button" class="btn" id="backup-export"
        >{getString(sourceLang, 'backupExport')}</button
      >
      <label class="btn backup__import">
        {getString(sourceLang, 'backupImport')}
        <input type="file" id="backup-import" accept="application/json,.json" />
      </label>
    </div>
    <p id="backup-status" role="status" aria-live="polite"></p>
  </section>

  <script
    type="application/json"
    id="progress-data"
    set:html={JSON.stringify({ sourceLang, targetLang, trackedItems })}
  />
</BaseLayout>

<style>
  .progress-level {
    margin-bottom: calc(var(--spacing-unit) * 2);
  }
  .backup__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-unit);
  }
  .backup__import {
    position: relative;
  }
  .backup__import input {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
  }
  .backup__import:focus-within {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
  .report textarea {
    width: 100%;
    font: inherit;
    margin: calc(var(--spacing-unit) * 0.5) 0 var(--spacing-unit);
  }
  .report__preview {
    white-space: pre-wrap;
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }
  .cando {
    list-style: none;
    padding: 0;
  }
  .cando__item {
    margin-bottom: var(--spacing-unit);
  }
  .cando__marks {
    display: block;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }
  .progress-level__label {
    display: flex;
    justify-content: space-between;
    font-weight: 600;
    margin-bottom: calc(var(--spacing-unit) * 0.5);
  }
</style>

<script>
  import { loadState, loadStudied, exportProgress, importProgress } from '../../../lib/storage';
  import {
    computeCefrProgress,
    computeCanDoChecklist,
    type TrackedItem,
  } from '../../../lib/progress';
  import { loadBreakDates, countRecentBreaks } from '../../../lib/calibration';
  import { getString, format } from '../../../lib/strings';
  import { loadGradeLog, computeRetention, rememberedItems } from '../../../lib/gradeLog';
  import { buildSessionReport } from '../../../lib/sessionReport';

  interface DataItem {
    itemId: string;
    nodeId: string;
    cefrLevel: string;
    canDo: string;
  }

  const dataEl = document.getElementById('progress-data');
  const { sourceLang, targetLang, trackedItems } = JSON.parse(dataEl?.textContent ?? '{}') as {
    sourceLang: string;
    targetLang: string;
    trackedItems: DataItem[];
  };

  const items: TrackedItem[] = trackedItems.map((item) => ({
    ...item,
    repetitions: loadState(sourceLang, targetLang, 'forward', item.itemId).repetitions,
  }));

  const { levels, nextRecommended } = computeCefrProgress(items);

  const masteredLabel = getString(sourceLang, 'progressMastered');
  const levelsEl = document.getElementById('progress-levels')!;
  levelsEl.innerHTML = levels.length
    ? levels
        .map(
          (l) => `
      <div class="progress-level">
        <p class="progress-level__label">
          <span class="badge badge--${l.cefrLevel.toLowerCase()}">${l.cefrLevel}</span>
          <span>${l.masteredItems}/${l.totalItems} ${masteredLabel}</span>
        </p>
        <div class="progress-bar"><div class="progress-bar__fill" style="width: ${l.percent}%"></div></div>
      </div>`
        )
        .join('')
    : `<p>${getString(sourceLang, 'progressNoContent')}</p>`;

  const nextEl = document.getElementById('progress-next')!;
  nextEl.textContent = nextRecommended
    ? format(getString(sourceLang, 'progressNextUp'), {
        canDo: nextRecommended.canDo,
        level: nextRecommended.cefrLevel,
      })
    : getString(sourceLang, 'progressAllMastered');

  // Revealed in the same task that renders the levels above them, so they
  // never shift after first paint (CLS) and stay hidden when JS is unavailable.
  nextEl.hidden = false;
  document.getElementById('backup')!.hidden = false;

  // Calibration signal (issue #46) — the book's "fluency illusion" warning:
  // learners are poor judges of their own mastery. Surfaces how often a
  // confident Good/Easy grade was followed by a struggling Again/Hard grade
  // within the last week, computed from real grading history, not a guess.
  const recentBreaks = countRecentBreaks(loadBreakDates(sourceLang, targetLang), new Date());
  const calibrationEl = document.getElementById('progress-calibration')!;
  if (recentBreaks > 0) {
    calibrationEl.hidden = false;
    calibrationEl.textContent = format(getString(sourceLang, 'progressCalibration'), {
      n: recentBreaks,
      itemWord: getString(sourceLang, recentBreaks === 1 ? 'itemSingular' : 'itemPlural'),
    });
  }

  // Retention (spec M2) and session report (spec M1), from the local grade log.
  const gradeLog = loadGradeLog(sourceLang, targetLang);
  const retention = computeRetention(gradeLog);

  // Spec J3: lead with the goal: the current level's Can-Dos, later levels collapsed.
  // Can-Do text comes from validated content YAML, but is escaped by textContent anyway.
  const canDoEl = document.getElementById('progress-cando')!;
  const mark = (done: boolean, label: string): string =>
    `${done ? '✓' : '○'} ${label}<span class="sr-only"> ${done ? 'done' : 'not yet'}</span>`;
  for (const level of computeCanDoChecklist(
    items,
    loadStudied(sourceLang, targetLang),
    rememberedItems(gradeLog)
  )) {
    const details = document.createElement('details');
    details.open = level.current;
    const summary = document.createElement('summary');
    summary.textContent = `${level.cefrLevel}: ${level.canDos.filter((c) => c.remembered).length}/${level.canDos.length} Can-Dos remembered`;
    const list = document.createElement('ul');
    list.className = 'cando';
    for (const c of level.canDos) {
      const li = document.createElement('li');
      li.className = 'cando__item';
      li.dataset.nodeId = c.nodeId;
      const text = document.createElement('span');
      text.textContent = c.canDo;
      const marks = document.createElement('span');
      marks.className = 'cando__marks';
      marks.innerHTML = [
        mark(c.studied, 'Studied'),
        mark(c.practised, 'Practised'),
        mark(c.remembered, 'Remembered after a week'),
      ].join(' · ');
      li.append(text, marks);
      list.append(li);
    }
    details.append(summary, list);
    canDoEl.append(details);
  }
  const retentionEl = document.getElementById('retention')!;
  document.getElementById('retention-text')!.textContent =
    retention.rate === null
      ? 'Come back a week after you first learn some words: this will show how many you still remember.'
      : `Of ${retention.opportunities} words you met again after a week or more, you remembered ${retention.recalled} (${Math.round(retention.rate * 100)}%).`;
  retentionEl.hidden = false;

  const commentEl = document.getElementById('report-comment') as HTMLTextAreaElement;
  const previewEl = document.getElementById('report-preview')!;
  const emailEl = document.getElementById('report-email') as HTMLAnchorElement;
  const currentReport = (): string =>
    buildSessionReport({
      sourceLang,
      targetLang,
      log: gradeLog,
      levels: levels.map(({ cefrLevel, masteredItems, totalItems }) => ({
        cefrLevel,
        masteredItems,
        totalItems,
      })),
      comment: commentEl.value,
      generatedOn: new Date().toISOString().slice(0, 10),
    });
  function refreshReport(): void {
    const report = currentReport();
    previewEl.textContent = report;
    emailEl.href = `mailto:phil.ruff@gmail.com?subject=${encodeURIComponent('Acquira session report')}&body=${encodeURIComponent(report)}`;
  }
  commentEl.addEventListener('input', refreshReport);
  refreshReport();
  document.getElementById('report-copy')!.addEventListener('click', async () => {
    const status = document.getElementById('report-status')!;
    try {
      await navigator.clipboard.writeText(currentReport());
      status.textContent = 'Copied. Paste it into a message to send it.';
    } catch {
      status.textContent = 'Could not copy. Select the text above and copy it.';
    }
  });
  document.getElementById('report')!.hidden = false;

  // Backup/restore (spec S5) — progress lives only in localStorage, so this is
  // the learner's only protection against clearing browser data.
  document.getElementById('backup-export')?.addEventListener('click', () => {
    const blob = new Blob([JSON.stringify(exportProgress(), null, 2)], {
      type: 'application/json',
    });
    const link = document.createElement('a');
    link.href = URL.createObjectURL(blob);
    link.download = `acquira-backup-${new Date().toISOString().slice(0, 10)}.json`;
    link.click();
    URL.revokeObjectURL(link.href);
  });

  const statusEl = document.getElementById('backup-status')!;
  document.getElementById('backup-import')?.addEventListener('change', async (event) => {
    const input = event.currentTarget as HTMLInputElement;
    const file = input.files?.[0];
    if (!file) return;
    const result = importProgress(await file.text());
    input.value = '';
    if (!result.ok) {
      statusEl.textContent = getString(sourceLang, 'backupImportFailed');
      return;
    }
    statusEl.textContent = format(getString(sourceLang, 'backupImported'), { n: result.count });
    // Re-render levels/next-up from the restored state.
    setTimeout(() => window.location.reload(), 1200);
  });
</script>
