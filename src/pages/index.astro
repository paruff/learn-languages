---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../lib/urls';
import { getAvailablePairs } from '../lib/pairLoader';
import { languageName } from '../lib/languageNames';

// The homepage isn't routed per language pair, so it picks the first
// available pair to link into — no hardcoded "/en-GB/pt-PT/" (prep for
// a second target language: adding one just needs content, this page
// adapts automatically).
const pairs = await getAvailablePairs();
const { sourceLang, targetLang } = pairs[0] ?? { sourceLang: 'en-GB', targetLang: 'pt-PT' };
const targetName = languageName(targetLang);

const [nodes, realisations] = await Promise.all([
  getCollection('cefr-nodes'),
  getCollection('realisations'),
]);
const firstLesson = nodes
  .filter((node) => node.data.cefrLevel === 'A1')
  .filter((node) =>
    realisations.some((r) => r.data.nodeId === node.data.nodeId && r.data.lang === targetLang)
  )
  .map((node) => node.data)
  .sort((a, b) => a.nodeId.localeCompare(b.nodeId))[0];
---

<BaseLayout
  title={`Acquira — Acquire ${targetName} with Science`}
  description={`Acquire ${targetName} through evidence-based lessons, spaced repetition, and interactive exercises. No gamification — just effective acquisition.`}
>
  <section class="hero" aria-labelledby="hero-title">
    <svg
      class="hero__motif"
      viewBox="0 0 160 160"
      preserveAspectRatio="xMidYMid slice"
      aria-hidden="true"
      focusable="false"
    >
      <defs>
        <pattern id="azulejo" width="40" height="40" patternUnits="userSpaceOnUse">
          <path d="M20 4 L36 20 L20 36 L4 20 Z" fill="none" stroke="currentColor" stroke-width="1.5"
          ></path>
          <circle cx="20" cy="20" r="5" fill="none" stroke="currentColor" stroke-width="1.5"
          ></circle>
        </pattern>
      </defs>
      <rect width="160" height="160" fill="url(#azulejo)"></rect>
    </svg>
    <div class="hero__content">
      <h1 id="hero-title">Acquire {targetName} with Science</h1>
      <p class="hero__subtitle">
        Evidence-based lessons built on second-language acquisition research, spaced repetition, and
        cognitive load theory. No gamification — just effective acquisition.
      </p>
      <a href={withBase(`/${sourceLang}/${targetLang}/lessons/`)} class="btn btn--primary"
        >Start your first lesson (2 min)</a
      >
    </div>
  </section>

  <section class="features" aria-labelledby="features-title">
    <h2 id="features-title" class="sr-only">Why this works</h2>
    <div class="features__grid">
      <article class="card feature">
        <svg
          class="feature__icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path
            d="M4 5a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H10l-4 4v-4H6a2 2 0 0 1-2-2V5z"
          ></path>
        </svg>
        <h3>Comprehensible Input</h3>
        <p>
          Lessons designed at i+1 level — challenging but understandable. Based on Krashen's Input
          Hypothesis.
        </p>
      </article>
      <article class="card feature">
        <svg
          class="feature__icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M4 9a8 8 0 0 1 14-5"></path>
          <path d="M20 4v5h-5"></path>
          <path d="M20 15a8 8 0 0 1-14 5"></path>
          <path d="M4 20v-5h5"></path>
        </svg>
        <h3>Spaced Repetition</h3>
        <p>
          SM-2 algorithm schedules reviews for optimal retention. No backend — runs entirely in your
          browser.
        </p>
      </article>
      <article class="card feature">
        <svg
          class="feature__icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="9"></circle>
          <path d="M15.5 8.5l-2 5-5 2 2-5z"></path>
        </svg>
        <h3>Autonomy & Competence</h3>
        <p>
          Self-paced with{' '}
          <a href={withBase(`/${sourceLang}/${targetLang}/progress/`)}>clear progress tracking</a>.
          Built on Self-Determination Theory for sustained motivation.
        </p>
      </article>
      <article class="card feature">
        <svg
          class="feature__icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 2 2 7l10 5 10-5-10-5z"></path>
          <path d="M2 12l10 5 10-5"></path>
          <path d="M2 17l10 5 10-5"></path>
        </svg>
        <h3>Cognitive Load Optimized</h3>
        <p>
          Multimedia principles applied: integrated audio/text, minimal extraneous load, coherence
          signaling.
        </p>
      </article>
    </div>
  </section>

  {
    firstLesson && (
      <section class="cta" aria-labelledby="cta-title">
        <h2 id="cta-title">Ready to begin?</h2>
        <p>Start with: {firstLesson.canDo}</p>
        <a
          href={withBase(`/${sourceLang}/${targetLang}/lessons/${firstLesson.nodeId}/`)}
          class="btn btn--primary"
        >
          First Lesson →
        </a>
      </section>
    )
  }
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    text-align: center;
    padding: calc(var(--spacing-unit) * 8) 0;
    border-radius: var(--radius-lg);
  }
  .hero__motif {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: var(--color-link);
    opacity: 0.08;
    z-index: 0;
  }
  .hero__content {
    position: relative;
    z-index: 1;
  }
  .hero h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    margin-bottom: calc(var(--spacing-unit) * 2);
  }
  .hero__subtitle {
    font-size: 1.25rem;
    color: var(--color-text-muted);
    max-width: 600px;
    margin: 0 auto calc(var(--spacing-unit) * 4);
  }
  .features__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: calc(var(--spacing-unit) * 3);
    margin-top: calc(var(--spacing-unit) * 4);
  }
  .feature {
    text-align: left;
    transition:
      transform var(--transition-normal),
      box-shadow var(--transition-normal);
  }
  .feature:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }
  .feature__icon {
    width: 32px;
    height: 32px;
    color: var(--color-accent-warm);
    margin-bottom: calc(var(--spacing-unit) * 1.5);
  }
  .feature h3 {
    margin-bottom: var(--spacing-unit);
    color: var(--color-primary);
  }
  .cta {
    text-align: center;
    padding: calc(var(--spacing-unit) * 8) 0;
    border-top: 1px solid var(--color-border);
    margin-top: calc(var(--spacing-unit) * 6);
  }
</style>
