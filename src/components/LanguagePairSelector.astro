---
export interface LanguagePairOption {
  sourceLang: string;
  targetLang: string;
}

interface Props {
  availablePairs: LanguagePairOption[];
  currentSourceLang: string;
  currentTargetLang: string;
}

const { availablePairs, currentSourceLang, currentTargetLang } = Astro.props;
const sourceLangs = [...new Set(availablePairs.map((p) => p.sourceLang))];
const targetOptions = availablePairs.filter((p) => p.sourceLang === currentSourceLang);
---

<form id="pair-selector" class="pair-selector" aria-label="Choose language pair">
  <label class="pair-selector__field">
    <span class="sr-only">Source language</span>
    <select id="pair-selector-source">
      {
        sourceLangs.map((lang) => (
          <option value={lang} selected={lang === currentSourceLang}>
            {lang}
          </option>
        ))
      }
    </select>
  </label>
  <span aria-hidden="true">→</span>
  <label class="pair-selector__field">
    <span class="sr-only">Target language</span>
    <select id="pair-selector-target">
      {
        targetOptions.map((p) => (
          <option value={p.targetLang} selected={p.targetLang === currentTargetLang}>
            {p.targetLang}
          </option>
        ))
      }
    </select>
  </label>
  <script
    type="application/json"
    id="pair-selector-data"
    set:html={JSON.stringify(availablePairs)}
  />
</form>

<style>
  .pair-selector {
    display: flex;
    align-items: center;
    gap: calc(var(--spacing-unit) * 0.5);
  }
  .pair-selector select {
    font: inherit;
    padding: calc(var(--spacing-unit) * 0.5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background-color: var(--color-bg);
    color: var(--color-text);
  }
</style>

<script>
  import { withBase } from '../lib/urls';
  import { savePairPreference } from '../lib/pairPreference';

  const dataEl = document.getElementById('pair-selector-data');
  const pairs = JSON.parse(dataEl?.textContent ?? '[]') as {
    sourceLang: string;
    targetLang: string;
  }[];

  const sourceSelect = document.getElementById('pair-selector-source') as HTMLSelectElement;
  const targetSelect = document.getElementById('pair-selector-target') as HTMLSelectElement;

  function refreshTargetOptions(): void {
    const valid = pairs.filter((p) => p.sourceLang === sourceSelect.value);
    targetSelect.innerHTML = valid
      .map((p) => `<option value="${p.targetLang}">${p.targetLang}</option>`)
      .join('');
  }

  sourceSelect.addEventListener('change', refreshTargetOptions);

  targetSelect.addEventListener('change', () => {
    const pref = { sourceLang: sourceSelect.value, targetLang: targetSelect.value };
    savePairPreference(pref);
    window.location.href = withBase(`/${pref.sourceLang}/${pref.targetLang}/review/`);
  });
</script>
