---
import { withBase } from '../lib/urls';
import { getAvailablePairs } from '../lib/pairLoader';
import { getString } from '../lib/strings';
import LanguagePairSelector from '../components/LanguagePairSelector.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  lang?: string;
  sourceLang?: string;
  targetLang?: string;
}

const {
  title,
  description = 'Acquire a new language through evidence-based lessons, spaced repetition, and interactive exercises — no gamification, just effective acquisition.',
  lang = 'en-GB',
  sourceLang = 'en-GB',
  targetLang = 'pt-PT',
} = Astro.props;
const availablePairs = await getAvailablePairs();
const fontUrl = withBase('/fonts/fraunces-latin-opsz144-wght600-700.woff2');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <!-- Self-hosted (spec S3): loading from Google Fonts sent every visitor's
         IP to Google. One variable latin-subset file covers 600-700 and every
         character pt/es/de/fr need. Inline @font-face (not global.css) so the
         URL honours the site base path. -->
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <style
      is:inline
      set:html={`@font-face{font-family:'Fraunces';font-style:normal;font-weight:600 700;font-display:swap;src:url('${fontUrl}') format('woff2');}`}
    ></style>
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <nav class="nav container" aria-label="Main navigation">
        <a href={withBase('/')} class="nav__brand" aria-label="Acquira home">Acquira</a>
        <ul class="nav__links">
          <li>
            <a href={withBase(`/${sourceLang}/${targetLang}/lessons/`)} class="nav__link"
              >{getString(sourceLang, 'navLessons')}</a
            >
          </li>
          <li>
            <a href={withBase(`/${sourceLang}/${targetLang}/review/`)} class="nav__link"
              >{getString(sourceLang, 'navPractice')}</a
            >
          </li>
          <li>
            <a href={withBase(`/${sourceLang}/${targetLang}/progress/`)} class="nav__link"
              >{getString(sourceLang, 'navProgress')}</a
            >
          </li>
          <li>
            <a href={withBase(`/${sourceLang}/${targetLang}/credits/`)} class="nav__link"
              >{getString(sourceLang, 'credits')}</a
            >
          </li>
        </ul>
        {
          availablePairs.length > 0 && (
            <LanguagePairSelector
              availablePairs={availablePairs}
              currentSourceLang={sourceLang}
              currentTargetLang={targetLang}
            />
          )
        }
      </nav>
    </header>
    <main class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <p class="footer__text">{getString(sourceLang, 'footer')}</p>
    </footer>
    <slot name="scripts" />
    <script is:inline define:vars={{ swUrl: withBase('/sw.js'), swScope: withBase('/') }}>
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register(swUrl, { scope: swScope }).catch(() => {}); // offline support is an enhancement; the app works without it
      }
    </script>
  </body>
</html>
