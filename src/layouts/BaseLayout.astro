---
import { withBase } from '../lib/urls';
import { getAvailablePairs } from '../lib/pairLoader';
import LanguagePairSelector from '../components/LanguagePairSelector.astro';
import '../styles/global.css';

interface Props {
  title: string;
  lang?: string;
  sourceLang?: string;
  targetLang?: string;
}

const { title, lang = 'en-GB', sourceLang = 'en-GB', targetLang = 'pt-PT' } = Astro.props;
const availablePairs = await getAvailablePairs();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Learn Portuguese with evidence-based lessons, spaced repetition, and interactive exercises."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Fetched without blocking render (media="print" until loaded), then
         swapped to apply — a plain `rel="stylesheet"` here is a render-blocking
         request that cost ~1.8s of Lighthouse performance score. -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@144,600;144,700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@144,600;144,700&display=swap"
      />
    </noscript>
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <nav class="nav container" aria-label="Main navigation">
        <a href={withBase('/')} class="nav__brand" aria-label="learn-languages home"
          >learn-languages</a
        >
        <ul class="nav__links">
          <li>
            <a href={withBase(`/${sourceLang}/${targetLang}/lessons/`)} class="nav__link">Lessons</a
            >
          </li>
          <li>
            <a href={withBase(`/${sourceLang}/${targetLang}/review/`)} class="nav__link">Practice</a
            >
          </li>
          <li>
            <a href={withBase(`/${sourceLang}/${targetLang}/progress/`)} class="nav__link"
              >Progress</a
            >
          </li>
        </ul>
        {
          availablePairs.length > 0 && (
            <LanguagePairSelector
              availablePairs={availablePairs}
              currentSourceLang={sourceLang}
              currentTargetLang={targetLang}
            />
          )
        }
      </nav>
    </header>
    <main class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <p class="footer__text">Built with Astro · Deployed via GitOps · CC-BY-4.0</p>
    </footer>
    <slot name="scripts" />
  </body>
</html>
