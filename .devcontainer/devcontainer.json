{
  "name": "learn-languages",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "upgradePackages": false
    },
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "astro-build.astro-vscode",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "github.vscode-github-actions",
        "ms-playwright.playwright",
        "redhat.vscode-yaml",
        "vitest.explorer"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit"
        },
        "eslint.validate": ["javascript", "typescript", "astro"],
        "prettier.enable": true,
        "typescript.tsdk": "node_modules/typescript/lib"
      }
    }
  },
  "forwardPorts": [4321],
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  // setup-bg.sh is a no-op once ~/.devcontainer-setup.done exists; re-launching
  // it on every start retries a background setup that failed at create time.
  "postStartCommand": "setsid nohup bash .devcontainer/setup-bg.sh >/dev/null 2>&1 </dev/null & npx lefthook install || true",
  "remoteUser": "node",
  "containerEnv": {
    "NODE_ENV": "development",
    "PLAYWRIGHT_BROWSERS_PATH": "/ms-playwright",
    "GEMINI_API_KEY": "${localEnv:GEMINI_API_KEY}"
  },
  "runArgs": ["--init"],
  "mounts": [
    "source=${localWorkspaceFolder}/.worktrees,target=/workspaces/.worktrees,type=bind,consistency=cached",
    // node_modules gets its own named volume so the container's linux
    // `npm ci` (post-create) and the host's darwin installs stop clobbering
    // each other through the bind-mounted workspace. Target matches the
    // Dockerfile WORKDIR; the image pre-creates the dir node-owned so
    // docker's first-mount copy-up seeds a writable volume.
    "source=learn-languages-node-modules,target=/workspaces/learn-languages/node_modules,type=volume"
  ]
}
